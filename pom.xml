<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>dev.francogomez.comercio</groupId>
    <artifactId>comercio</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>comercio</name>
    <description>Core transaccional de retail: ventas, stock y comprobantes</description>

    <modules>
        <module>contratos</module>
        <module>core</module>
        <module>reportes</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <testcontainers.version>1.21.3</testcontainers.version>
        <springdoc.version>2.8.6</springdoc.version>
        <jjwt.version>0.12.6</jjwt.version>
        <jacoco.version>0.8.13</jacoco.version>
        <sonar-maven-plugin.version>5.1.0.4751</sonar-maven-plugin.version>

        <!-- Los identificadores de SonarCloud derivan de la cuenta de GitHub, no del
             groupId de Maven: la organizacion es el login y la clave del proyecto es
             <login>_<repositorio>. -->
        <sonar.organization>frangmz09</sonar.organization>
        <sonar.projectKey>frangmz09_comercio</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <!-- En una sola linea y sin sangria: Maven no recorta el valor de una propiedad,
             asi que un salto de linea deja la ruta como "\n   /path/..." y no resuelve.
             La propiedad se hereda, y cada modulo resuelve su propio basedir. -->
        <sonar.coverage.jacoco.xmlReportPaths>${project.basedir}/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>

        <!-- Dos familias de falsos positivos que no vale la pena arrastrar:

             plsql:VarcharUsageCheck exige VARCHAR2 en lugar de VARCHAR, que es sintaxis
             de Oracle. Las migraciones son PostgreSQL, donde VARCHAR2 directamente no
             existe: Sonar esta analizando el DDL con el dialecto equivocado.

             java:S1135 marca comentarios con tareas pendientes buscando esa palabra en
             ingles, que en espanol es una palabra corriente: "recorrer el historial
             completo" no es una tarea pendiente. La regla es inservible en un codigo
             comentado en castellano.

             (Este comentario evita a proposito escribir la palabra que dispara la regla:
             xml:S1135 la detecta tambien en los XML, incluido este pom.) -->
        <sonar.issue.ignore.multicriteria>dialectoSql,todoEnEspanol</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.dialectoSql.ruleKey>plsql:VarcharUsageCheck</sonar.issue.ignore.multicriteria.dialectoSql.ruleKey>
        <sonar.issue.ignore.multicriteria.dialectoSql.resourceKey>**/db/migration/*.sql</sonar.issue.ignore.multicriteria.dialectoSql.resourceKey>
        <sonar.issue.ignore.multicriteria.todoEnEspanol.ruleKey>java:S1135</sonar.issue.ignore.multicriteria.todoEnEspanol.ruleKey>
        <sonar.issue.ignore.multicriteria.todoEnEspanol.resourceKey>**/*.java</sonar.issue.ignore.multicriteria.todoEnEspanol.resourceKey>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.francogomez.comercio</groupId>
                <artifactId>contratos</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Cobertura: unitarios (surefire) e integracion (failsafe) en un solo reporte -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Los *IT corren en failsafe (fase integration-test), no en surefire -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
