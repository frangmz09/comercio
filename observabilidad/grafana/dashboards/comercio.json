{
  "title": "comercio — operación",
  "uid": "comercio-operacion",
  "tags": ["comercio"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ventas registradas por minuto",
      "description": "Tasa de POST /api/v1/ventas que terminaron en 2xx.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqpm", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/ventas\",method=\"POST\",outcome=\"SUCCESS\"}[1m])) * 60",
          "legendFormat": "ventas/min"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Outbox pendiente",
      "description": "Eventos esperando publicación. Si sube y no baja, Kafka está caído o el publisher no corre: es la señal más directa de que la proyección de reportes se está quedando atrás.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "comercio_outbox_pendientes",
          "legendFormat": "pendientes"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Publicación del outbox",
      "description": "Eventos publicados contra intentos fallidos.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "fallidos" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(comercio_outbox_publicados_total[1m])",
          "legendFormat": "publicados"
        },
        {
          "refId": "B",
          "expr": "rate(comercio_outbox_fallidos_total[1m])",
          "legendFormat": "fallidos"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Eventos proyectados en reportes",
      "description": "Eventos consumidos y aplicados, y los que terminaron en el dead letter topic.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "al DLT" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(comercio_reportes_eventos_procesados_total[1m])",
          "legendFormat": "procesados"
        },
        {
          "refId": "B",
          "expr": "rate(comercio_reportes_eventos_duplicados_total[1m])",
          "legendFormat": "duplicados descartados"
        },
        {
          "refId": "C",
          "expr": "rate(comercio_reportes_eventos_dlt_total[1m])",
          "legendFormat": "al DLT"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latencia de la API (p95 y p99)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 0 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=~\"/api/v1/.*\"}[5m])) by (le, uri))",
          "legendFormat": "p95 {{uri}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{uri=~\"/api/v1/.*\"}[5m])) by (le))",
          "legendFormat": "p99 global"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Respuestas por código",
      "description": "Los 409 son esperables: stock insuficiente y reintentos idempotentes. Un salto de 5xx no lo es.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/v1/.*\"}[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
